#!/bin/bash
# NetworkManager dispatcher hook, installed to /etc/NetworkManager/dispatcher.d/ by the omarchy-local-ai package:
# when a ConnectX-7 port comes up, each logged-in user's engine probes the cable, and the first time another DGX
# Spark answers there waiting for setup, a desktop notification offers `omarchy-models link setup`. The engine runs
# by the path its package installs, since neither this hook nor a user's systemd manager has Omarchy's bin on PATH.
dev=$1 action=$2
engine=/usr/bin/omarchy-local-ai
[[ $action == up && -d /sys/class/net/$dev/device/infiniband ]] || exit 0
[[ -x $engine ]] || exit 0
for user in $(loginctl list-sessions --no-legend | awk '$3 != "root" {print $3}' | sort -u); do
  systemd-run --user -M "$user@" --quiet --collect -- "$engine" link notify || true
done
