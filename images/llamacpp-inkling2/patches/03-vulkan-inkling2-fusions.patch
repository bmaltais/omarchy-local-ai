diff --git c/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_depth_mix.comp i/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_depth_mix.comp
new file mode 100644
index 0000000..32e3c80
--- /dev/null
+++ i/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_depth_mix.comp
@@ -0,0 +1,113 @@
+#version 450
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+
+layout (binding = 0) readonly  buffer STACK { float data_stack[]; };
+layout (binding = 1) readonly  buffer CUR   { float data_cur[];   };
+layout (binding = 2) readonly  buffer QUERY { float data_query[]; };
+layout (binding = 3) writeonly buffer DST   { float data_dst[];   };
+
+#define BLOCK_SIZE 256
+#define MAX_ROWS 16
+#define MAX_SG 16
+layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+layout (push_constant) uniform parameter {
+    uint32_t stack_off, cur_off, query_off, dst_off;
+    uint32_t n, B, Q, T;
+    uint32_t stack_s1, stack_s2, cur_s1, query_s1;
+    uint32_t norm_cur;
+    float eps, scale;
+} p;
+
+shared float s_sg[MAX_SG][MAX_ROWS + 2];
+
+void main() {
+    const uint32_t q   = gl_WorkGroupID.x;
+    const uint32_t t   = gl_WorkGroupID.y;
+    const uint32_t tid = gl_LocalInvocationID.x;
+    if (q >= p.Q || t >= p.T) {
+        return;
+    }
+
+    const uint32_t qb = p.query_off + q * p.query_s1;
+    const uint32_t sb = p.stack_off + t * p.stack_s2;
+    const uint32_t cb = p.cur_off   + t * p.cur_s1;
+
+    float acc[MAX_ROWS + 2];
+    [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS + 2u; ++r) {
+        acc[r] = 0.0f;
+    }
+
+    for (uint32_t i = tid; i < p.n; i += BLOCK_SIZE) {
+        const float qi = data_query[qb + i];
+        [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS; ++r) {
+            if (r < p.B) {
+                acc[r] += data_stack[sb + r * p.stack_s1 + i] * qi;
+            }
+        }
+        const float xi = data_cur[cb + i];
+        acc[MAX_ROWS]      += xi * qi;
+        acc[MAX_ROWS + 1u] += xi * xi;
+    }
+
+    // Subgroup reduction into shared memory — only ONE barrier for ALL rows!
+    [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS + 2u; ++r) {
+        if (r < p.B || r >= MAX_ROWS) {
+            float v = subgroupAdd(acc[r]);
+            if (gl_SubgroupInvocationID == 0u) {
+                s_sg[gl_SubgroupID][r] = v;
+            }
+        }
+    }
+    barrier();
+
+    const uint32_t n_sg = gl_NumSubgroups;
+    [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS + 2u; ++r) {
+        if (r < p.B || r >= MAX_ROWS) {
+            float tot = 0.0f;
+            for (uint32_t sg = 0u; sg < n_sg; ++sg) {
+                tot += s_sg[sg][r];
+            }
+            acc[r] = tot;
+        }
+    }
+
+    const float sc = (p.norm_cur != 0u) ? inversesqrt(acc[MAX_ROWS + 1u] / float(p.n) + p.eps) : 1.0f;
+
+    float mx = p.scale * (sc * acc[MAX_ROWS]);
+    [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS; ++r) {
+        if (r < p.B) {
+            acc[r] = p.scale * acc[r];
+            mx = max(mx, acc[r]);
+        }
+    }
+
+    float p_cur = exp(p.scale * (sc * acc[MAX_ROWS]) - mx);
+    float sum = 0.0f;
+    [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS; ++r) {
+        if (r < p.B) {
+            acc[r] = exp(acc[r] - mx);
+            sum += acc[r];
+        }
+    }
+    sum += p_cur;
+
+    const float inv = 1.0f / sum;
+    [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS; ++r) {
+        acc[r] *= inv;
+    }
+    p_cur *= inv * sc;
+
+    for (uint32_t i = tid; i < p.n; i += BLOCK_SIZE) {
+        float o = 0.0f;
+        [[unroll]] for (uint32_t r = 0u; r < MAX_ROWS; ++r) {
+            if (r < p.B) {
+                o += acc[r] * data_stack[sb + r * p.stack_s1 + i];
+            }
+        }
+        o += p_cur * data_cur[cb + i];
+        data_dst[p.dst_off + (t * p.n + i) * p.Q + q] = o;
+    }
+}
diff --git c/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_l2_clip.comp i/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_l2_clip.comp
new file mode 100644
index 0000000..d99bac1
--- /dev/null
+++ i/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_l2_clip.comp
@@ -0,0 +1,69 @@
+#version 450
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+
+layout (binding = 0) readonly  buffer X { float data_x[]; };
+layout (binding = 1) readonly  buffer W { float data_w[]; };
+layout (binding = 2) readonly  buffer F { float data_f[]; };
+layout (binding = 3) writeonly buffer D { float data_d[]; };
+
+#define BLOCK_SIZE 256
+#define MAX_SG 16
+layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+layout (push_constant) uniform parameter {
+    uint32_t ncols, nrows, nchannels, nsamples;
+    uint32_t x_off, w_off, f_off, d_off;
+    uint32_t s1, s2, s3;
+    uint32_t ws1, ws2, ws3;
+    uint32_t fs2, fs3;
+    uint32_t flags; // bit0=has_w, bit1=has_f
+    float eps, scale, bias;
+} p;
+
+shared float s_sg[MAX_SG];
+
+void main() {
+    const uint32_t row = gl_WorkGroupID.x;
+    const uint32_t tid = gl_LocalInvocationID.x;
+    if (row >= p.nrows) {
+        return;
+    }
+    const bool has_w = (p.flags & 1u) != 0u;
+    const bool has_f = (p.flags & 2u) != 0u;
+
+    for (uint32_t sample_idx = gl_WorkGroupID.z; sample_idx < p.nsamples; sample_idx += gl_NumWorkGroups.z) {
+        for (uint32_t ch = gl_WorkGroupID.y; ch < p.nchannels; ch += gl_NumWorkGroups.y) {
+            const uint32_t xb = p.x_off + sample_idx * p.s3 + ch * p.s2 + row * p.s1;
+            const uint32_t wb = p.w_off + sample_idx * p.ws3 + ch * p.ws2 + row * p.ws1;
+            const uint32_t db = p.d_off + ((sample_idx * p.nchannels + ch) * p.nrows + row) * p.ncols;
+
+            float tmp = 0.0f;
+            for (uint32_t col = tid; col < p.ncols; col += BLOCK_SIZE) {
+                const float xi = has_w ? (data_x[xb + col] * data_w[wb + col]) : data_x[xb + col];
+                tmp += xi * xi;
+            }
+            float sg_sum = subgroupAdd(tmp);
+            if (gl_SubgroupInvocationID == 0u) {
+                s_sg[gl_SubgroupID] = sg_sum;
+            }
+            barrier();
+
+            float tot = 0.0f;
+            for (uint32_t sg = 0u; sg < gl_NumSubgroups; ++sg) {
+                tot += s_sg[sg];
+            }
+
+            const float l2 = inversesqrt(max(tot, p.eps * p.eps));
+            const float fc = has_f ? data_f[p.f_off + sample_idx * p.fs3 + ch * p.fs2] : 1.0f;
+
+            for (uint32_t col = tid; col < p.ncols; col += BLOCK_SIZE) {
+                const float xi = has_w ? (data_x[xb + col] * data_w[wb + col]) : data_x[xb + col];
+                const float yi = p.scale * (l2 * xi) + p.bias;
+                data_d[db + col] = has_f ? (yi * fc) : yi;
+            }
+            barrier();
+        }
+    }
+}
diff --git c/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_loop_ctrl_down.comp i/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_loop_ctrl_down.comp
new file mode 100644
index 0000000..0e5af0e
--- /dev/null
+++ i/ggml/src/ggml-vulkan/vulkan-shaders/inkling2_loop_ctrl_down.comp
@@ -0,0 +1,57 @@
+#version 450
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_arithmetic : enable
+
+layout (binding = 0) readonly  buffer CUR  { float data_cur[];  };
+layout (binding = 1) readonly  buffer MSG  { float data_msg[];  };
+layout (binding = 2) readonly  buffer W    { float data_w[];    };
+layout (binding = 3) writeonly buffer GATE { float data_gate[]; };
+
+#define BLOCK_SIZE 256
+#define MAX_SG 16
+layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
+
+layout (push_constant) uniform parameter {
+    uint32_t cur_off, msg_off, w_off, gate_off;
+    uint32_t n, cur_s1, msg_s1, w_s1, gate_s1;
+    float eps;
+} p;
+
+shared vec4 s_sg[MAX_SG];
+
+void main() {
+    const uint32_t r   = gl_WorkGroupID.x;
+    const uint32_t t   = gl_WorkGroupID.y;
+    const uint32_t tid = gl_LocalInvocationID.x;
+
+    const uint32_t cb = p.cur_off + t * p.cur_s1;
+    const uint32_t mb = p.msg_off + t * p.msg_s1;
+    const uint32_t wb = p.w_off   + r * p.w_s1;
+
+    vec4 acc = vec4(0.0f);
+    for (uint32_t i = tid; i < p.n; i += BLOCK_SIZE) {
+        const float c = data_cur[cb + i];
+        const float m = data_msg[mb + i];
+        acc.x += c * c;
+        acc.y += m * m;
+        acc.z += data_w[wb + i] * c;
+        acc.w += data_w[wb + p.n + i] * m;
+    }
+
+    vec4 sg_sum = subgroupAdd(acc);
+    if (gl_SubgroupInvocationID == 0u) {
+        s_sg[gl_SubgroupID] = sg_sum;
+    }
+    barrier();
+
+    if (tid == 0u) {
+        vec4 tot = vec4(0.0f);
+        for (uint32_t sg = 0u; sg < gl_NumSubgroups; ++sg) {
+            tot += s_sg[sg];
+        }
+        data_gate[p.gate_off + t * p.gate_s1 + r] =
+            inversesqrt(tot.x / float(p.n) + p.eps) * tot.z +
+            inversesqrt(tot.y / float(p.n) + p.eps) * tot.w;
+    }
+}
