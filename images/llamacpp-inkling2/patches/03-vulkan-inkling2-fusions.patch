+                ggml_op ops[8];
+                int n = 0;
+                if (has_norm) ops[n++] = GGML_OP_RMS_NORM;
+                ops[n++] = GGML_OP_CONCAT;
+                if (has_rep)  ops[n++] = GGML_OP_REPEAT;
+                ops[n++] = GGML_OP_MUL_MAT;
+                ops[n++] = GGML_OP_SOFT_MAX;
+                ops[n++] = GGML_OP_TRANSPOSE;
+                ops[n++] = GGML_OP_CONT;
+                ops[n++] = GGML_OP_MUL_MAT;
