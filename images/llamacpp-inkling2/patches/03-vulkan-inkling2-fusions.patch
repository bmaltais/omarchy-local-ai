+static bool ggml_vk_can_bcast_to(const ggml_tensor * src, const ggml_tensor * dst, int first_dim) {
+    for (int d = first_dim; d < GGML_MAX_DIMS; ++d) {
+        if (src->ne[d] != 1 && src->ne[d] != dst->ne[d]) {
+            return false;
+        }
+    }
+    return true;
