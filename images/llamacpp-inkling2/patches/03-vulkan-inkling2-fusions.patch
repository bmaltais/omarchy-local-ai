+    const uint32_t c = gl_GlobalInvocationID.x;
+    if (c >= p.C) {
+        return;
+    }
+
+    const int K  = int(p.K);
+    const int K1 = K - 1;
+    const bool has_dyn = (p.flags & 1u) != 0u;
+    const bool has_res = (p.flags & 2u) != 0u;
+
