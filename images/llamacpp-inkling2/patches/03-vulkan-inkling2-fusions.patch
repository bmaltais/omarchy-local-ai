+layout (binding = 0) readonly  buffer PAST  { float data_past[];  };
+layout (binding = 1) readonly  buffer CUR   { float data_cur[];   };
+layout (binding = 2) readonly  buffer W     { float data_w[];     };
+layout (binding = 3) readonly  buffer DYN   { float data_dyn[];   };
+layout (binding = 4) readonly  buffer RES   { float data_res[];   };
+layout (binding = 5) writeonly buffer DST   { float data_dst[];   };
+layout (binding = 6) writeonly buffer STATE { float data_state[]; };
+
+#define MAX_K 8
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout (push_constant) uniform parameter {
+    uint32_t past_off, cur_off, w_off, dyn_off, res_off, dst_off, state_off;
+    uint32_t past_s1, past_s2, dyn_s1;
+    uint32_t state_slot_s, state_ch_s, state_seq_s;
+    uint32_t C, K, Ts, S, kw, run, n_heads, flags; // bit0=has_dyn, bit1=has_res
+    float scale, bias;
