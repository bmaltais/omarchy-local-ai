+    [[unroll]] for (int m = 0; m < MAX_K; ++m) {
+        w[m] = (m >= MAX_K - K) ? data_w[p.w_off + c * p.K + uint32_t(m - (MAX_K - K))] : 0.0f;
+    }
+
+    const uint32_t n_runs = (p.Ts + p.run - 1u) / p.run;
+    const uint32_t total_runs = p.S * n_runs;
+    const uint32_t head_idx = has_dyn ? (c / (p.C / p.n_heads)) : 0u;
+
+    for (uint32_t r = gl_WorkGroupID.y; r < total_runs; r += gl_NumWorkGroups.y) {
+        const uint32_t s  = r / n_runs;
+        const int t0 = int((r - s * n_runs) * p.run);
