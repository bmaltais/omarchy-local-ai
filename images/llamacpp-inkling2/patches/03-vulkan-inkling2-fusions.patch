+    }
+
+    test_l2_clip(std::array<int64_t, 4> ne = {128, 24, 3, 1}, bool with_w = true, bool with_f = false, float thr = 22.6f)
+        : ne(ne), with_w(with_w), with_f(with_f), thr(thr) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
