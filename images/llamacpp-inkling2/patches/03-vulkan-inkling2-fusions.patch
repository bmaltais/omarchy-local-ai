diff --git c/ggml/src/ggml-vulkan/ggml-vulkan.cpp i/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index fa573e6..edf995b 100644
--- c/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ i/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -4138,6 +4138,13 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     ggml_vk_create_pipeline(device, device->pipeline_snake_f16,  "snake_f16",  snake_f16_len,  snake_f16_data,  "main", 4, sizeof(vk_op_snake_push_constants), {256, 1, 1}, {}, 1);
